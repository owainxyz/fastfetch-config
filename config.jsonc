{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": {
      "1": "38;2;255;255;255",
      "2": "38;2;255;255;255",
      "3": "38;2;255;255;255",
      "4": "38;2;255;255;255",
      "5": "38;2;255;255;255",
      "6": "38;2;255;255;255",
      "7": "38;2;255;255;255",
      "8": "38;2;255;255;255",
      "9": "38;2;255;255;255"
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "os",
      "format": "{2} {9}"
    },
    {
      "type": "host",
      "key": "host"
    },
    {
      "type": "kernel",
      "key": "kernel",
      "format": "{2}"
    },
    {
      "type": "uptime",
      "key": "uptime",
      "format": "{2}h {3}m"
    },
    {
      "type": "memory",
      "key": "memory",
      "format": "{1} / {2}"
    },
    {
      "type": "packages",
      "key": "pkgs",
      "format": "{1}"
    },
    "break",
    {
      "type": "colors",
      "block": {
        "range": [1, 6]
      }
    }
  ]
}
